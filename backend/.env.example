PORT=5000
NODE_ENV=development
JWT_SECRET=smartclass360_super_secret_key
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=30d
# Render Postgres (preferred in production). If set, PG_* below are ignored.
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=smartclass360
PG_USER=postgres
PG_PASSWORD=postgres
ML_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Set to true to skip automatic default admin/teacher/student creation on boot
SKIP_DEFAULT_USER_SEED=
# Set to true to skip automatic schema.sql apply when public.users is missing
SKIP_AUTO_SCHEMA_INIT=
